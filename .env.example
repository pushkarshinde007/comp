# ============================================================
# CivicSignal AI - Root Environment Blueprint
# See backend/.env.example and frontend/.env.example for component configurations.
# NEVER commit real credentials or .env files to Git.
# ============================================================

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Gemini AI Configuration (Backend Only - NEVER expose to frontend)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=30

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
