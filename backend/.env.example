# ============================================================
# CivicSignal AI - Backend Environment Configuration Template
# Copy this file to .env and configure as needed.
# NEVER commit real credentials or keys to version control.
# ============================================================

# Core Application Settings
PROJECT_NAME="CivicSignal AI API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# CORS Configuration (comma-separated origins allowed to access the API)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Server Host and Port
HOST="127.0.0.1"
PORT=8000

# ------------------------------------------------------------
# Google Gemini AI Configuration (Phase 2)
# ------------------------------------------------------------
# Obtain your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""

# Gemini model identifier (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL="gemini-2.5-flash"

# Request timeout in seconds
GEMINI_TIMEOUT_SECONDS=30.0

# Maximum permitted image upload size in bytes (default: 5MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# ------------------------------------------------------------
# Future Integration Stubs (Reserved for Phase 3+)
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID="(default)"
